# Copy this file to .env for development:  cp .env.example .env
# .env is ignored by git. This example file is committed.
# Real environment variables always win over values in .env.

# Development only. With DEBUG on, settings.py uses a built-in dev secret key.
DJANGO_DEBUG=1

# On a server: DEBUG off, and a long random secret key.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=

# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# FRONTEND_URL=http://localhost:5274

# Turn on only once the site is really served over HTTPS.
# DJANGO_HTTPS=1

# Postgres: set DB_NAME to switch from SQLite.
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
